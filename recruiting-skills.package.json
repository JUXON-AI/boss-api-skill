{
  "name": "boss-recruiting-skills",
  "version": "1.3.0",
  "description": "BOSS招聘持续跟进本地skills集合；本清单不注册插件或执行安装",
  "entrypoint": "boss-recruiting-followup",
  "skills": [
    "boss-recruiting-deepseek-harness",
    "boss-recruiting-followup",
    "boss-recruiting-collect",
    "boss-recruiting-review",
    "boss-recruiting-message",
    "boss-recruiting-talent",
    "boss-recruiting-profile",
    "boss-recruiting-resume",
    "boss-recruiting-push",
    "boss-recruiting-audit"
  ],
  "layout": "skills/<name>/SKILL.md",
  "installation": "Use scripts/recruiting-skills-install.mjs with --host codex or --host deepseek-harness. Keep all skill directories and implementationSkill as siblings. Execute helpers from the workspace repository with its original scripts/skills layout.",
  "hosts": {
    "codex": {"entrypoint": "boss-recruiting-followup", "homeEnv": "CODEX_HOME", "defaultHome": "~/.codex"},
    "deepseek-harness": {"entrypoint": "boss-recruiting-deepseek-harness", "homeEnv": "DSH_HOME", "defaultHome": "~/.dsh"}
  },
  "containsPrivateTaskData": false,
  "implementationSkill": "skills/boss-recruiting-agent",
  "technicalSkill": "SKILL.md"
}
