{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOSS recruiting run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "job_profile", "authorized_contacting", "candidate_source", "candidates"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "job_profile": {"type": "string", "minLength": 1},
    "authorized_contacting": {"type": "boolean"},
    "candidate_source": {"const": "explicit_user_list"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "name", "boss_job_id", "max_rounds"],
        "properties": {
          "uid": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "boss_job_id": {"type": "string", "minLength": 1},
          "max_rounds": {"type": "integer", "minimum": 1, "maximum": 2},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
