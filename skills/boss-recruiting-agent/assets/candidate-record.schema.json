{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOSS recruiting candidate record",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["screening_policy"]},
      "then": {"properties": {"job_fit": {"required": ["conditions"]}}}
    }
  ],
  "required": [
    "schema_version",
    "policy_version",
    "job",
    "candidate",
    "history",
    "score",
    "state",
    "facts",
    "communication",
    "recommendation",
    "next_round",
    "next_action",
    "sources",
    "updated_at",
    "job_fit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boss_job_id",
        "job_profile_sha256"
      ],
      "properties": {
        "boss_job_id": {
          "type": "string",
          "minLength": 1
        },
        "job_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "name"
      ],
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "complete",
        "checked_at",
        "last_mid",
        "last_direction"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete": {
          "const": true
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_mid": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "last_direction": {
          "enum": [
            "in",
            "out",
            "none"
          ]
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "ability_base_score",
        "evidence_coverage_percent",
        "competitions",
        "github_projects",
        "competition_bonus",
        "github_bonus",
        "proof_bonus",
        "final_signal_score",
        "evaluation_sha256"
      ],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_role_skills",
            "project_depth",
            "engineering_habits",
            "learning_and_collaboration"
          ],
          "properties": {
            "core_role_skills": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "project_depth": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "engineering_habits": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "learning_and_collaboration": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "ability_base_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "evidence_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "competitions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "github_projects": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "competition_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 18
        },
        "github_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 18
        },
        "proof_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "final_signal_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "evaluation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "state": {
      "enum": [
        "ready_for_contact",
        "needs_more_info",
        "awaiting_candidate_reply",
        "ai_screened_pass",
        "talent_pool_candidate",
        "current_role_mismatch",
        "stop_contact",
        "skipped_unknown_base",
        "hr_review",
        "closed"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "unverified",
        "unknown"
      ],
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "last_outbound_mid",
        "last_outbound_at",
        "pending_inbound_mids"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "last_outbound_mid": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "last_outbound_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pending_inbound_mids": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "no_reply_required": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mid",
            "reason",
            "source"
          ],
          "properties": {
            "mid": {
              "type": [
                "integer",
                "string"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "recommendation": {
      "enum": [
        "continue_contact",
        "ready_for_hr",
        "hold",
        "talent_pool",
        "stop",
        "skip"
      ]
    },
    "next_round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "hard_condition_status"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "hard_condition_status": {
          "enum": [
            "unknown",
            "pass",
            "partial",
            "conflict"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "status",
              "evidence"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "confirmed",
                  "unknown",
                  "conflict"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "quote"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "screening_policy": {
      "$ref": "job-screening-policy.schema.json"
    }
  }
}
