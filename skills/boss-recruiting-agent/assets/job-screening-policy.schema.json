{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit company/department/job screening policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "company_key",
    "department_key",
    "boss_job_id",
    "approved",
    "max_substantive_rounds",
    "proof_bonus",
    "dimensions",
    "thresholds",
    "conditions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "company_key": {
      "type": "string",
      "minLength": 1
    },
    "department_key": {
      "type": "string",
      "minLength": 1
    },
    "boss_job_id": {
      "type": "string",
      "minLength": 1
    },
    "approved": {
      "type": "boolean"
    },
    "max_substantive_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "proof_bonus": {
      "const": "none"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_role_skills",
        "project_depth",
        "engineering_habits",
        "learning_and_collaboration"
      ],
      "properties": {
        "core_role_skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "weight",
            "rubric"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rubric": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "project_depth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "weight",
            "rubric"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rubric": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "engineering_habits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "weight",
            "rubric"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rubric": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "learning_and_collaboration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "weight",
            "rubric"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rubric": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ability_base",
        "coverage",
        "signal",
        "job_fit"
      ],
      "properties": {
        "ability_base": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "signal": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "job_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
